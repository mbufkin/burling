# Python bytecode and virtualenvs — never commit generated runtime files.
__pycache__/
*.py[cod]
.venv/
venv/

# Machine-specific overrides. The repo ships config.example.yaml.
.env
.env.*
rclone.conf
burling/config.yaml

# The real handover dump. Point --intake at it; do not copy it into this repo.
corpus/
burling/intake/*
!burling/intake/.gitkeep
!burling/intake/README.md

# Review output can hold redacted PII findings. Keep the folder, not the files.
burling/output/*
!burling/output/.gitkeep

# Pack artifacts from copying source off a workstation.
*.zip
*.egg-info/
dist/
build/
